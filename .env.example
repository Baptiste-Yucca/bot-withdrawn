PRIVATE_KEY=your_private_key_here
RPC_URL_GNOSIS=https://rpc.gnosischain.com

# Withdraw configuration
MIN_WITHDRAW_USD=100         # Minimum withdraw amount in USD (protection against gas draining bots)

# Gas configuration for withdraw (USD-based strategy)
# gasPrice is computed so that: gasPrice × gasLimit ≤ GAS_MAX_COST_USD
GAS_LIMIT_WITHDRAW=300000    # Fixed gas limit for withdraw transactions
GAS_MAX_COST_USD=0.01        # Max gas cost in USD/xDAI for withdraw
GAS_MIN_PRICE_GWEI=0.8       # Skip if derived gas price < min (tx wouldn't be accepted)

# Transfer to destination address
DEST_ADDRESS=your_destination_address_here
GAS_TRANSFER_PRICE_GWEI=1    # Fixed gas price for transfer (in Gwei)
