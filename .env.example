PRIVATE_KEY=your_private_key_here
RPC_URL_GNOSIS=https://rpc.gnosischain.com

# Withdraw configuration
MIN_WITHDRAW_USD=100         # Minimum withdraw amount in USD (protection against gas draining bots)

# Gas configuration for withdraw transactions
GAS_PRICE_GWEI=2             # Gas price in Gwei (e.g. 2, 200)
GAS_MAX_COST_USD=0.01        # Max gas cost in USD/xDAI, skip withdraw if exceeded (0 = no limit)

# Transfer to destination address
DEST_ADDRESS=your_destination_address_here
GAS_TRANSFER_DEST_GWEI=2     # Gas price for transfer to DEST_ADDRESS